# ═══════════════════════════════════════════════════════════
# .env — Portfolio Backend Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — add it to .gitignore
# ═══════════════════════════════════════════════════════════

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string-50-chars
DEBUG=True   # Set to False in production

# Gmail SMTP
# Step 1: Enable 2-Factor Auth on your Gmail
# Step 2: Go to Google Account → Security → App Passwords
# Step 3: Create App Password for "Mail" → paste it below
EMAIL_HOST_USER=atulkumargupta7654@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx   # 16-char Gmail App Password

# Where contact form notifications will be delivered
CONTACT_RECEIVER_EMAIL=atulkumargupta7654@gmail.com

# Secret key to view messages via API (keep this private)
ADMIN_SECRET_KEY=your-secret-admin-key-here
